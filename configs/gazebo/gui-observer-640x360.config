<?xml version="1.0"?>
<window>
  <width>640</width>
  <height>360</height>
  <menus>
    <drawer default="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>Drone simulation compact</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.08 0.09 0.12</background_color>
  <camera_pose>-10 -10 9 0 0.55 0.78</camera_pose>
</plugin>

<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">1</property><property key="height" type="double">1</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">1</property><property key="height" type="double">1</property></gz-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
  <gz-gui><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property><property key="width" type="double">1</property><property key="height" type="double">1</property></gz-gui>
</plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">64</property><property type="double" key="z">1</property><property type="string" key="state">floating</property><anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors></gz-gui>
  <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused><use_event>true</use_event>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <gz-gui><property type="bool" key="showTitleBar">false</property><property type="bool" key="resizable">false</property><property type="double" key="height">100</property><property type="double" key="width">250</property><property type="double" key="z">1</property><property type="string" key="state">floating</property><anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors></gz-gui>
  <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
</plugin>
