{
  "schema_version": 1,
  "label": "camera-lidar-smoke",
  "launch": {
    "program": "gz",
    "args": [
      "sim",
      "-s",
      "-r",
      "--headless-rendering",
      "examples/camera-lidar-world.sdf"
    ],
    "environment": {}
  },
  "stats_topic": "/world/simopt_sensors/stats",
  "required_topics": ["/simopt/camera", "/simopt/lidar"],
  "message_check_topics": ["/simopt/camera", "/simopt/lidar"],
  "working_directory": "../..",
  "gz_command": "gz",
  "warmup_seconds": 2.0,
  "duration_seconds": 5.0,
  "repeats": 2,
  "startup_timeout_seconds": 20.0,
  "message_timeout_seconds": 10.0,
  "shutdown_grace_seconds": 3.0,
  "inter_run_delay_seconds": 0.5,
  "window_seconds": 1.0,
  "collect_process_metrics": true,
  "resource_sample_interval_ms": 250,
  "collect_capabilities": true,
  "fingerprint_files": ["examples/camera-lidar-world.sdf"]
}
