{
  "schema_version": 1,
  "label": "b2-physics-headless",
  "launch": {
    "program": "gz",
    "args": ["sim", "-s", "-r", "--headless-rendering", "examples/camera-lidar-stress-world.sdf"],
    "environment": {}
  },
  "stats_topic": "/world/simopt_sensor_stress/stats",
  "required_topics": ["/simopt/stress/imu"],
  "message_check_topics": ["/simopt/stress/imu"],
  "load_topics": [],
  "working_directory": "../..",
  "gz_command": "gz",
  "warmup_seconds": 30.0,
  "duration_seconds": 60.0,
  "repeats": 3,
  "startup_timeout_seconds": 30.0,
  "message_timeout_seconds": 20.0,
  "shutdown_grace_seconds": 5.0,
  "inter_run_delay_seconds": 1.0,
  "window_seconds": 1.0,
  "collect_process_metrics": true,
  "resource_sample_interval_ms": 250,
  "collect_capabilities": true,
  "fingerprint_files": ["examples/camera-lidar-stress-world.sdf"]
}
