{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/simopt/benchmark-report.schema.json",
  "title": "simopt benchmark report",
  "type": "object",
  "required": [
    "schema_version",
    "label",
    "source",
    "sample_count",
    "valid_interval_count",
    "excluded_interval_count",
    "clock_reset_count",
    "total_wall_time_s",
    "total_sim_time_s",
    "total_rtf",
    "window_seconds",
    "window_rtf",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "label": { "type": "string" },
    "source": { "type": "string" },
    "sample_count": { "type": "integer", "minimum": 2 },
    "valid_interval_count": { "type": "integer", "minimum": 1 },
    "excluded_interval_count": { "type": "integer", "minimum": 0 },
    "clock_reset_count": { "type": "integer", "minimum": 0 },
    "total_wall_time_s": { "type": "number", "exclusiveMinimum": 0 },
    "total_sim_time_s": { "type": "number", "exclusiveMinimum": 0 },
    "total_rtf": { "type": "number", "minimum": 0 },
    "window_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "window_rtf": { "$ref": "#/$defs/distribution" },
    "process_metrics": {
      "type": "object",
      "required": [
        "source",
        "sample_count",
        "wall_time_s",
        "cpu_time_s",
        "average_cpu_cores",
        "peak_rss_bytes",
        "warnings"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "wall_time_s": { "type": "number", "minimum": 0 },
        "cpu_time_s": { "type": ["number", "null"], "minimum": 0 },
        "average_cpu_cores": { "type": ["number", "null"], "minimum": 0 },
        "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "peak_process_count": { "type": "integer", "minimum": 1 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "required": [
        "source",
        "egl_device",
        "gl_renderer",
        "device_name",
        "software"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "egl_device": { "type": ["string", "null"] },
        "gl_renderer": { "type": ["string", "null"] },
        "device_name": { "type": ["string", "null"] },
        "software": { "type": "boolean" },
        "log_modified_unix_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "distribution": {
      "type": "object",
      "required": ["count", "min", "p05", "median", "p95", "max"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "min": { "type": "number", "minimum": 0 },
        "p05": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
