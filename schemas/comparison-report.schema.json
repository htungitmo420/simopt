{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/simopt/comparison-report.schema.json",
  "title": "simopt comparison report",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_label",
    "candidate_label",
    "baseline_rtf",
    "candidate_rtf",
    "absolute_rtf_change",
    "relative_rtf_change_percent",
    "minimum_gain_percent",
    "performance_gate_passed",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "baseline_label": { "type": "string" },
    "candidate_label": { "type": "string" },
    "baseline_rtf": { "type": "number", "minimum": 0 },
    "candidate_rtf": { "type": "number", "minimum": 0 },
    "absolute_rtf_change": { "type": "number" },
    "relative_rtf_change_percent": { "type": ["number", "null"] },
    "minimum_gain_percent": { "type": "number", "minimum": 0 },
    "performance_gate_passed": { "type": "boolean" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
