{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/simopt/benchmark-suite-report.schema.json",
  "title": "simopt repeated benchmark report",
  "type": "object",
  "required": [
    "schema_version",
    "label",
    "scenario",
    "run_count",
    "total_rtf",
    "window_median_rtf",
    "window_p05_rtf",
    "runs",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "label": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "run_count": { "type": "integer", "minimum": 1 },
    "total_rtf": { "$ref": "benchmark-report.schema.json#/$defs/distribution" },
    "window_median_rtf": { "$ref": "benchmark-report.schema.json#/$defs/distribution" },
    "window_p05_rtf": { "$ref": "benchmark-report.schema.json#/$defs/distribution" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "benchmark-report.schema.json" }
    },
    "fingerprint": {
      "type": "object",
      "required": ["algorithm", "scenario", "workload_files", "capability_report"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "scenario": { "$ref": "#/$defs/artifact_fingerprint" },
        "workload_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact_fingerprint" }
        },
        "capability_report": {
          "anyOf": [
            { "$ref": "#/$defs/artifact_fingerprint" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "artifact_fingerprint": {
      "type": "object",
      "required": ["path", "size_bytes", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
